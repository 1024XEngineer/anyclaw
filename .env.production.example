# AnyClaw production deployment environment
#
# Copy to `.env.production` on the server and fill real secrets there.
# Do not commit real tokens.

# -----------------------------------------------------------------------------
# Public access
# -----------------------------------------------------------------------------
# Server public IP used before a domain is ready, for example: 203.0.113.10
ANYCLAW_PUBLIC_IP=

# Optional domain. Leave empty for the first IP-only deployment.
ANYCLAW_PUBLIC_DOMAIN=

# http for IP-only deployment, https after domain + TLS is configured.
ANYCLAW_PUBLIC_SCHEME=http

# -----------------------------------------------------------------------------
# Registry
# -----------------------------------------------------------------------------
# Internal registry listen address inside the container.
ANYCLAW_REGISTRY_ADDR=:8791

# Registry data directory inside the container. This must be backed by a volume.
ANYCLAW_REGISTRY_DATA_DIR=/data

# Development/first production pass uses sqlite. Do not switch to postgres until
# the deployment build includes a confirmed maintained Postgres driver.
ANYCLAW_REGISTRY_DB_DRIVER=sqlite
ANYCLAW_REGISTRY_DB_DSN=/data/registry.db

# Required for public deployment. Generate a long random value on the server.
ANYCLAW_REGISTRY_ADMIN_TOKEN=

# Production safety guard. When true, registry refuses to start without an
# admin token. Keep true for public deployments.
ANYCLAW_REGISTRY_REQUIRE_ADMIN_TOKEN=true

# Seed fixture artifacts when the registry is empty. Keep false in production
# after real marketplace data is published.
ANYCLAW_REGISTRY_SEED=false

# Registry is intentionally not published as a public port in
# docker-compose.prod.yml. Public browser access should use the website's
# same-origin /v1/* proxy.

# -----------------------------------------------------------------------------
# AnyClaw Gateway
# -----------------------------------------------------------------------------
# Keep the Gateway private unless there is a specific reason to expose it.
# docker-compose.prod.yml binds it to 127.0.0.1 by default.
ANYCLAW_GATEWAY_HOST=0.0.0.0
ANYCLAW_GATEWAY_PORT=18789

# Required if Gateway is reachable from outside localhost or a private network.
ANYCLAW_API_TOKEN=

# Gateway reads cloud marketplace artifacts from this endpoint.
# IP-only direct registry option:
#   http://${ANYCLAW_PUBLIC_IP}:8791
# Same-origin reverse-proxy option after Round 2:
#   http://${ANYCLAW_PUBLIC_IP}/v1
# Domain + HTTPS option after Round 12:
#   https://${ANYCLAW_PUBLIC_DOMAIN}/v1
ANYCLAW_MARKETPLACE_ENDPOINT=
ANYCLAW_REGISTRY_TOKEN=
ANYCLAW_MARKETPLACE_DISABLE_REMOTE=false
ANYCLAW_MARKETPLACE_CACHE_TTL_SECONDS=60
ANYCLAW_MARKETPLACE_REQUEST_TIMEOUT_SECONDS=30
ANYCLAW_MARKETPLACE_AUTO_INSTALL_SKILL=false

# -----------------------------------------------------------------------------
# Website
# -----------------------------------------------------------------------------
# Internal static website port. Public access should go through port 80/443.
ANYCLAW_WEBSITE_PORT=8080

# Browser-facing registry API base used by the website.
# Prefer `/v1` when the reverse proxy exposes registry under the same origin.
ANYCLAW_WEBSITE_REGISTRY_BASE=/v1

# -----------------------------------------------------------------------------
# Optional LLM variables for Gateway runtime
# -----------------------------------------------------------------------------
ANYCLAW_LLM_PROVIDER=
ANYCLAW_LLM_MODEL=
ANYCLAW_LLM_API_KEY=
