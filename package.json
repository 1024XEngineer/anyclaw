{
  "name": "anyclaw-web-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:build": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "desktop:start": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop.ps1",
    "ui:install": "node scripts/ui.mjs install",
    "ui:dev": "node scripts/ui.mjs dev",
    "ui:build": "node scripts/ui.mjs build",
    "ui:preview": "node scripts/ui.mjs preview",
    "ui:test": "node scripts/ui.mjs test",
    "site:dev": "corepack pnpm --dir site dev",
    "site:build": "corepack pnpm --dir site build",
    "site:preview": "corepack pnpm --dir site preview"
  },
  "packageManager": "pnpm@10.23.0"
}
